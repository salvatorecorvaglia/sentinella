{
    "name": "sentinella-web-dashboard",
    "packageManager": "pnpm@12.16.1",
    "version": "1.2.0",
    "private": true,
    "description": "JavaScript tooling for the sentinella web console.",
    "type": "commonjs",
    "scripts": {
        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "test:watch": "vitest",
