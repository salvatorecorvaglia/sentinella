        "lint:fix": "biome check --write .",
        "format": "biome format --write ."
    },
    "devDependencies": {
        "@biomejs/biome": "^2.6.4",
        "@vitest/coverage-v8": "^5.0.5",
        "jsdom": "^30.1.3",
        "vitest": "^5.0.5"
    }
}
